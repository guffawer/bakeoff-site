; Engine configuration file.
config_version=5

[application]

config/name="Monsoon Recovery Co. look test"
config/description="Throwaway look test: bus off the edge, ghat road, monsoon, 9:40 pm."
config/version="0.0.1-look"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.05, 0.06, 0.06, 1)
boot_splash/show_image=false

[display]

window/size/viewport_width=405
window/size/viewport_height=720
window/stretch/mode="disabled"
window/handheld/orientation=1

[input_devices]

pointing/emulate_mouse_from_touch=true

[physics]

2d/physics_engine="Dummy"
3d/physics_engine="Dummy"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=0
lights_and_shadows/directional_shadow/size=1024
lights_and_shadows/positional_shadow/atlas_size=1024
environment/defaults/default_clear_color=Color(0.03, 0.04, 0.045, 1)
